# ─── App ───────────────────────────────────────────────
VITE_APP_NAME=Nexus
VITE_APP_VERSION=1.0.0

# ─── API ───────────────────────────────────────────────
# Base URL for your backend REST API (either name works)
# VITE_API_URL=http://localhost:4000/api
VITE_API_BASE_URL=http://localhost:4000/api

# ─── WebSocket ─────────────────────────────────────────
# Socket.IO server URL (either name works)
# VITE_SOCKET_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# ─── Auth ──────────────────────────────────────────────
# Secret key used for JWT signing (backend only — NEVER put in VITE_* or commit real values)
# JWT_SECRET=your_super_secret_key_here

# Demo admin seed password (client mock auth only — change in local .env; do not commit secrets)
# VITE_DEMO_ADMIN_PASSWORD=change-me

# ─── Image uploads (ImgBB) ─────────────────────────────
# Free key at https://api.imgbb.com/ — this VITE_* key is bundled in the client.
# Prefer a backend upload proxy in production; never commit a real key.
VITE_IMGBB_API_KEY=

# ─── Feature Flags ─────────────────────────────────────
# Offline/mock mode is active when API/SOCKET URLs above are empty.
# VITE_ENABLE_MOCK_API is reserved for future use and is not read by the app yet.
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_ANALYTICS=false

# ─── Vercel ────────────────────────────────────────────
# Deploy from the project root (Git import or `vercel` CLI) — do not commit this file.
# In Vercel → Project Settings → Environment Variables, set for Production (and Preview):
#   VITE_IMGBB_API_KEY=<your key>
# Leave VITE_API_BASE_URL / VITE_WS_URL unset for client-only mock mode on Vercel.
# VITE_* values are baked in at build time — change a key, then redeploy.
